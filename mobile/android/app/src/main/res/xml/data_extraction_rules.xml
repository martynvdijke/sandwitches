<?xml version="1.0" encoding="utf-8"?>
<!--
    The app stores the Sandwitches session cookie and server URL on the device.
    Neither belongs in a cloud backup or on a device the user migrates to, so
    every domain is excluded. android:allowBackup="false" already opts out of
    backup; these rules keep the exclusion explicit and intact if that
    attribute is ever changed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
