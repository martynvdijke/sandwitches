<div class="layout layout--col gap">
  <div class="grid grid--cols-1">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--medium">{{ IDX_0.title }}</span>
      </div>
    </div>
  </div>
  {% for user in IDX_1.data %}
    {% if user.id == IDX_0.uploaded_by %}
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Made by - {{ user.username }} </span>
      </div>
    </div>
    {% endif %}
  {% endfor %}
  {% for user in IDX_1.data %}
    {% if IDX_0.favorited_by contains user.id %}
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Favourited by : {{ user.username }} </span>
      </div>
    </div>
    {% endif %}
  {% endfor %}
  <img class="image image-dither image-contain rounded" src="{{ trml.plugin_settings.custom_fields_values.url | default: 'https://sandwitches.vandijke.xyz' }}{{ IDX_0.image }}" />
</div>
<div class="title_bar">
  <img width="60" src="{{ trml.plugin_settings.custom_fields_values.url | default: 'https://sandwitches.vandijke.xyz' }}/static/icons/icon.svg">
  <span class="title">Sandwiches so good </span>
</div>