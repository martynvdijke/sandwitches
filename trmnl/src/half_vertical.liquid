<div class="layout layout--col gap">
  <div class="col col--start gap">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--medium">{{ IDX_0.title }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--small">{{ IDX_0.description }}</span>
      </div>
    </div>
    {% for user in IDX_1.data %}
    {% if user.id == IDX_0.uploaded_by %}
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Made by - {{ user.username }} </span>
      </div>
    </div>
    {% endif %}
    {% endfor %}
    {% for user in IDX_1.data %}
    {% if IDX_0.favorited_by contains user.id %}
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Favourited by : {{ user.username }} </span>
      </div>
    </div>
    {% endif %}
    {% endfor %}
    <img class="image image-contain rounded image-dither" height=280px src="{{ trml.plugin_settings.custom_fields_values.url }}{{ IDX_0.image }}" />
  </div>
</div>
<div class="title_bar">
  <img width="60" src="{{ trml.plugin_settings.custom_fields_values.url }}/static/icons/icon.012a40b047f9.svg">
  <span class="title">Sandwiches so good ! </span>
</div>