# Sandwitches environment. Copy to .env (or pass these in docker-compose) and
# adjust. Values marked "required" have no safe default.

# --- Core -------------------------------------------------------------------
# Required: signs the session cookie and request tokens. Use a long random value.
SECRET_KEY=change-me-to-a-long-random-value
# Required in production: comma-separated hostnames this server may serve.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required in production: origins allowed for unsafe form posts.
CSRF_TRUSTED_ORIGINS=http://localhost:6270,http://127.0.0.1:6270

DATABASE_FILE=/config/db.sqlite3
MEDIA_ROOT=/config/media
LOG_FILE=/config/media/sandwitches.log
PORT=6270
DEBUG=false
LANGUAGE_CODE=en

# --- Email (optional) -------------------------------------------------------
SEND_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

# --- Push / analytics / telemetry (optional) --------------------------------
GOTIFY_URL=
GOTIFY_TOKEN=
UMAMI_HOST=
UMAMI_WEBSITE_ID=

# Standard OpenTelemetry variables. Telemetry stays disabled while unset.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_SERVICE_NAME=sandwitches
OTEL_SDK_DISABLED=true

# --- API --------------------------------------------------------------------
API_CORS_ORIGINS=
API_RATE_LIMIT_RATE=10
API_RATE_LIMIT_BURST=100

# --- OIDC / Authelia (optional) --------------------------------------------
# Leave OIDC_ENABLED=false to use local password accounts only.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://sandwitches.vandijke.xyz/api/auth/oidc/callback
OIDC_SCOPES=openid email profile groups
OIDC_LOGOUT_URL=

# --- Legal pages (/privacy, /terms, /account/delete) ------------------------
# Name of the person or organisation that decides what data is processed.
# Fallback: "the operator of this Sandwitches instance".
LEGAL_CONTROLLER_NAME=
# Privacy contact. Fallback: the contact email configured in admin settings.
# Without either, the pages direct people to the administrator / deletion page.
LEGAL_CONTACT_EMAIL=
# Optional postal address shown on the privacy policy.
LEGAL_CONTACT_ADDRESS=
# Where the server and backups are hosted. Fallback: "the European Union".
LEGAL_HOSTING_REGION=the European Union
# Public base URL used in policy links. Fallback: https://sandwitches.vandijke.xyz
LEGAL_BASE_URL=https://sandwitches.vandijke.xyz
# Optional data protection officer contact shown on the privacy policy.
LEGAL_DPO_EMAIL=
# Supervisory authority people may complain to.
# Fallback: "your local data protection authority".
LEGAL_SUPERVISORY_AUTHORITY=

# --- Demo account (public/shared) ------------------------------------------
# WARNING: the demo account is a single PUBLIC login whose username and
# password are shown on the login page and via GET /api/v1/auth/config.
# Anyone can sign in and change its content. Keep it disabled on private
# instances; only enable it on a review/demo instance with no private data.
# Leave it unset to auto-enable only when LEGAL_BASE_URL's host is
# sandwitches.vandijke.xyz. Set false to force it off, or true to force it on.
# DEMO_USER_ENABLED=false
DEMO_USER_USERNAME=demo
DEMO_USER_PASSWORD=demo
DEMO_USER_EMAIL=demo@sandwitches.local
