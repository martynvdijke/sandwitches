{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "automergeType": "pr",
  "dependencyDashboard": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/__fixtures__/**",
    "test/**"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "platformAutomerge": true,
  "prCreation": "immediate",
  "prHourlyLimit": 10,
  "rebaseWhen": "auto",
  "configMigration": true,
  "timezone": "Europe/Amsterdam",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ],
  "github-actions": {
    "enabled": true
  },
  "pep621": {
    "enabled": true
  },
  "npm": {
    "enabled": true
  },
  "automergeStrategy": "squash"
}
