<div class="columns">
  <div class="column">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--medium">{{ IDX_0.title }}</span>
      </div>
    </div>
    <div class="col col--start gap">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small">{{ IDX_0.description }}</span>
        </div>
      </div>
      {% for user in IDX_1.data %}
        {% if user.id == IDX_0.uploaded_by %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="label">Made by - {{ user.username }} </span>
          </div>
        </div>
        {% endif %}
      {% endfor %}
      {% for user in IDX_1.data %}
        {% if IDX_0.favorited_by contains user.id %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="label">Favourited by : {{ user.username }} </span>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="column">
      <img class="image image-cover image-dither rounded" src="{{ trml.plugin_settings.custom_fields_values.url }}{{ IDX_0.image }}" />
    </div>
</div>

<div class="title_bar">
  <img class="image image--contain" src="{{ trml.plugin_settings.custom_fields_values.url }}/static/icons/icon.012a40b047f9.svg">
  <span class="title">Sandwiches so good, they haunt you! {{ trml.plugin_settings.custom_fields_values.url }} </span>
</div>